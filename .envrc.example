export AWS_DEFAULT_PROFILE="your-aws-profile-name"

# Proxmox provider endpoint
export TF_VAR_proxmox_endpoint="https://x86-node-01:8006/"

ssm_values="$(
  aws --profile "$AWS_DEFAULT_PROFILE" ssm get-parameters \
    --names \
      "/infra/sgfdevs/infra-vm-workloads/TF_VAR_proxmox_api_token" \
      "/infra/sgfdevs/infra-vm-workloads/TF_VAR_b2_application_key_id" \
      "/infra/sgfdevs/infra-vm-workloads/TF_VAR_b2_application_key" \
      "/infra/sgfdevs/infra-vm-workloads/TF_VAR_cloudflare_sgfdevs_api_token" \
      "/infra/sgfdevs/infra-vm-workloads/TF_VAR_cloudflare_opensgf_api_token" \
    --with-decryption --output json --no-cli-pager |
    jq '.Parameters | map({key: (.Name | split("/") | last), value: .Value}) | from_entries'
)"

export TF_VAR_proxmox_api_token="$(jq -r '.TF_VAR_proxmox_api_token' <<< "$ssm_values")"
export TF_VAR_b2_application_key_id="$(jq -r '.TF_VAR_b2_application_key_id' <<< "$ssm_values")"
export TF_VAR_b2_application_key="$(jq -r '.TF_VAR_b2_application_key' <<< "$ssm_values")"

# Cloudflare Tunnel provider auth
export TF_VAR_cloudflare_sgfdevs_api_token="$(jq -r '.TF_VAR_cloudflare_sgfdevs_api_token' <<< "$ssm_values")"
export TF_VAR_cloudflare_opensgf_api_token="$(jq -r '.TF_VAR_cloudflare_opensgf_api_token' <<< "$ssm_values")"

unset ssm_values
